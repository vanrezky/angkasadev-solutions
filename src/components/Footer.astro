---
import { tr, url, site, type Lang } from '../data/site';
const { lang }=Astro.props as {lang:Lang}; const t=tr[lang];
---
<footer class="footer"><div class="container"><div class="footer-grid">
<div><a class="brand" href={url(lang,'home')}><svg class="brand-icon" viewBox="0 0 64 64" aria-hidden="true"><path d="M5 54 26 10 47 54 M15 39h22" fill="none" stroke="#171717" stroke-width="9" stroke-linejoin="round"/><path d="m43 9 16 24-16 23" fill="none" stroke="#ff713b" stroke-width="9" stroke-linejoin="round"/></svg><span class="brand-name">AngkasaDev<span class="brand-sub">Solutions</span></span></a><p>{t.footerDesc}</p></div>
<div><strong>{lang==='id'?'Jelajahi':'Explore'}</strong><div class="footer-links">{t.nav.map((n,i)=><a href={url(lang,t.navKeys[i])}>{n}</a>)}<a href={url(lang,'contact')}>{t.contact}</a></div></div>
<div><strong>{lang==='id'?'Hubungi kami':'Get in touch'}</strong><div class="footer-links"><a href={`mailto:${site.email}`}>{site.email}</a><a href={`https://wa.me/${site.wa}`} target="_blank" rel="noopener noreferrer">+62 822 6826 2017</a><span class="muted" style="font-size:14px;line-height:1.7">{site.address}</span></div></div>
</div><div class="footer-bottom"><span>© {new Date().getFullYear()} AngkasaDev Solutions. {t.rights}</span><a href={url(lang,'privacy')}>{lang==='id'?'Kebijakan Privasi':'Privacy Policy'}</a><span>Designed with intention. Built to last.</span></div></div></footer>
