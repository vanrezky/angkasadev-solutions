---
const cards = [
  { image: 'portfolio-logistics', tone: 'blue' },
  { image: 'portfolio-seo', tone: 'gold' },
  { image: 'portfolio-erp', tone: 'green' },
] as const;
---

<hero-portfolio class="hero-portfolio" aria-hidden="true">
  {cards.map(({ image, tone }, index) => (
    <div class:list={['portfolio-preview', tone]}>
      <img src={`/images/${image}.webp`} alt="" width="1448" height="1086"
        fetchpriority={index === 0 ? 'high' : undefined} decoding="async"/>
    </div>
  ))}
</hero-portfolio>

<script>
  class HeroPortfolio extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let frame = 0;

      const render = () => {
        frame = 0;
        const bounds = this.getBoundingClientRect();
        const distance = Math.max(-1, Math.min(1, 1 - (bounds.bottom + bounds.height * .2) / innerHeight));
        this.style.setProperty('--rotation', `${distance * 26}deg`);
        this.style.setProperty('--travel', `${distance * -70}px`);
      };

      const requestRender = () => {
        if (!frame) frame = requestAnimationFrame(render);
      };

      const syncMotion = () => {
        window.removeEventListener('scroll', requestRender);
        window.removeEventListener('resize', requestRender);
        cancelAnimationFrame(frame);
        frame = 0;
        if (reducedMotion.matches) {
          this.style.removeProperty('--rotation');
          this.style.removeProperty('--travel');
          return;
        }

        window.addEventListener('scroll', requestRender, { passive: true });
        window.addEventListener('resize', requestRender, { passive: true });
        requestRender();
      };

      reducedMotion.addEventListener('change', syncMotion);
      syncMotion();
      this.cleanup = () => {
        reducedMotion.removeEventListener('change', syncMotion);
        window.removeEventListener('scroll', requestRender);
        window.removeEventListener('resize', requestRender);
        cancelAnimationFrame(frame);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('hero-portfolio')) customElements.define('hero-portfolio', HeroPortfolio);
</script>

<style>
  .hero-portfolio {
    display: block;
    position: relative;
    height: clamp(390px, 36vw, 550px);
    min-width: 0;
    isolation: isolate;
    --rotation: 0deg;
    --travel: 0px;
  }

  .portfolio-preview {
    position: absolute;
    width: var(--card-width);
    aspect-ratio: 1.95;
    overflow: hidden;
    padding: clamp(5px, .65vw, 10px);
    border-radius: clamp(10px, 1.5vw, 20px);
    background: var(--mat);
    box-shadow: 0 18px 38px #11182738;
    transform: translateY(calc(var(--travel) * var(--speed))) rotate(calc(var(--angle) + var(--rotation) * var(--speed)));
  }

  .portfolio-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 49%;
    border-radius: inherit;
  }

  .blue {
    --card-width: 77%;
    --mat: #1945b7;
    --angle: -17deg;
    --speed: .65;
    top: 2%;
    left: 4%;
  }

  .gold {
    --card-width: 75%;
    --mat: #eda826;
    --angle: 12deg;
    --speed: .88;
    top: 29%;
    right: 2%;
  }

  .green {
    --card-width: 77%;
    --mat: #16846a;
    --angle: -10deg;
    --speed: 1;
    top: 55%;
    left: 11%;
  }

  @media (max-width: 800px) {
    .hero-portfolio {
      width: min(100%, 580px);
      height: auto;
      aspect-ratio: 1.12;
      margin-inline: auto;
    }
  }
</style>
