---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HeroPortfolio from '../../components/HeroPortfolio.astro';
import ProcessStory from '../../components/ProcessStory.astro';
import WorkCards from '../../components/WorkCards.astro';
import ContactForm from '../../components/ContactForm.astro';
import { tr, url, paths, site, type Lang } from '../../data/site';

const serviceKeys = ['development','enhancement','seo','design'] as const;
const sym = ['⌘','↗','◎','✳'];
type PageKey = 'home'|'services'|'work'|'about'|'insights'|'contact'|'privacy'|typeof serviceKeys[number];
export function getStaticPaths(){
  return (['id','en'] as Lang[]).flatMap(lang => Object.entries(paths[lang]).map(([page,slug]) => ({params:{lang,slug:slug||undefined},props:{page:page as PageKey,lang}})));
}
const {page,lang} = Astro.props as {page:PageKey;lang:Lang};
const t=tr[lang];
const idx=serviceKeys.indexOf(page as typeof serviceKeys[number]);
const serviceDetail = idx>=0;
const pageTitles:Record<PageKey,string>={home:lang==='id'?'Software Development & Solusi Digital':'Software Development & Digital Solutions',services:lang==='id'?'Layanan Kami':'Our Services',work:lang==='id'?'Portfolio & Karya':'Our Work',about:lang==='id'?'Tentang Kami':'About Us',insights:'Insights',contact:lang==='id'?'Konsultasi Gratis':'Free Consultation',privacy:t.privacyTitle,development:t.serviceNames[0],enhancement:t.serviceNames[1],seo:t.serviceNames[2],design:t.serviceNames[3]};
const metaDescription = page==='home'?t.heroDesc:page==='contact'?t.contactLead:serviceDetail?t.serviceDesc[idx]:page==='about'?t.aboutLead:page==='work'?t.workDesc:page==='insights'?t.insightsLead:page==='privacy'?t.privacyLead:t.servicesDesc;
const waLink = `https://wa.me/${site.wa}?text=${encodeURIComponent(lang==='id'?'Halo AngkasaDev Solutions, saya ingin konsultasi mengenai proyek digital.':'Hello AngkasaDev Solutions, I would like to discuss a digital project.')}`;
---
<Base lang={lang} page={page} title={`${pageTitles[page]} | AngkasaDev Solutions`} description={metaDescription}>
<Header lang={lang} page={page}/>
<main id="main-content">
{page==='home' && <>
  <section class="hero"><div class="container hero-grid"><div><h1>{t.hero1}<br/>{t.hero2}<br/><span class="underlined">{t.hero3}</span></h1><p class="lead">{t.heroDesc}</p><div class="hero-actions"><a class="btn" href={url(lang,'contact')}>{t.heroCTA} <span aria-hidden="true">↗</span></a><a class="btn secondary" href={url(lang,'work')}>{t.workCTA} <span aria-hidden="true">↗</span></a></div></div><HeroPortfolio/></div></section>
  <section class="section"><div class="container intro-grid"><div class="intro-visual"><img src="/images/development-team.webp" alt={lang==='id'?'Ilustrasi kolaborasi tim dalam pengembangan sistem digital':'Illustration of a team collaborating on digital product development'} width="1600" height="1200" loading="lazy" decoding="async"/></div><div><h2>{t.introTitle}</h2><p class="lead">{t.introDesc}</p><a class="text-link" href={url(lang,'about')}>{lang==='id'?'Lebih tentang kami':'More about us'} ↗</a></div></div></section>
  <section class="services-section"><div class="container"><div class="section-head"><div><h2>{t.servicesTitle}</h2></div><p class="lead">{t.servicesDesc}</p></div><div class="services-grid">{t.serviceNames.map((name,i)=><a href={url(lang,t.serviceKeys[i])} class="service-card"><span class="service-mark" aria-hidden="true">{sym[i]}</span><div class="service-bottom"><div><h3>{name}</h3><p>{t.serviceDesc[i]}</p></div></div></a>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><h2>{t.workTitle}</h2></div><p class="lead">{t.workDesc}</p></div><WorkCards lang={lang}/><p class="work-disclaimer">{t.workNote}</p><a class="text-link" href={url(lang,'work')}>{t.workCTA} ↗</a></div></section>
  <section class="section studio-section"><div class="container"><div class="section-head"><div><h2>{lang==='id'?'Dari ide menjadi produk yang bekerja.':'From ideas to working products.'}</h2></div><p class="lead">{lang==='id'?'Proses yang terstruktur, kolaborasi yang jelas, dan pengalaman produk yang dirancang untuk kebutuhan nyata.':'Structured development, clear collaboration, and purposeful digital products.'}</p></div><div class="studio-grid">{[
    {image:'process-development',id:'Proses development',en:'Development process',desc:'Perencanaan, implementasi, testing dan delivery.',descEn:'Planning, implementation, testing, and delivery.'},
    {image:'development-team',id:'Kolaborasi tim',en:'Team collaboration',desc:'Diskusi teknis, sprint review dan pengembangan bertahap.',descEn:'Technical discussions, sprint reviews and incremental development.'},
    {image:'mobile-development',id:'Mobile development',en:'Mobile development',desc:'Perancangan dan pengembangan pengalaman aplikasi mobile.',descEn:'Designing and developing mobile application experiences.'}
  ].map(item=><article class="studio-card"><div class="studio-visual"><img src={`/images/${item.image}.webp`} alt={lang==='id'?item.id:item.en} width="1600" height="1200" loading="lazy" decoding="async"/></div><div class="studio-info"><h3>{lang==='id'?item.id:item.en}</h3><p>{lang==='id'?item.desc:item.descEn}</p></div></article>)}</div><p class="work-disclaimer">{lang==='id'?'Gambar proses dan tim merupakan visual ilustratif, bukan dokumentasi foto tim sebenarnya.':'Process and team images are illustrative, not actual photos of the team.'}</p></div></section>
  <ProcessStory lang={lang}/>
  <section class="section"><div class="container why-grid"><div><h2>{t.whyTitle}</h2><p class="lead">{t.whyDesc}</p></div><div class="why-list">{t.whyItems.map((item,i)=><div><span>0{i+1}</span>{item}</div>)}</div></div></section>
</>}
{page==='services' && <><div class="container"><div class="page-hero"><h1>{t.servicesTitle}</h1><p class="lead">{t.servicesDesc}</p></div><div class="services-grid">{t.serviceNames.map((name,i)=><a href={url(lang,t.serviceKeys[i])} class="service-card"><span class="service-mark" aria-hidden="true">{sym[i]}</span><div class="service-bottom"><div><h3>{name}</h3><p>{t.serviceDesc[i]}</p></div></div></a>)}</div></div></>}
{serviceDetail && <section class="container"><div class="page-hero detail-hero"><h1>{t.serviceNames[idx]}</h1><p class="lead">{t.serviceDesc[idx]}</p></div><div class="detail-layout"><div><h2>{lang==='id'?'Dibangun sesuai kebutuhan bisnis Anda.':'Built around your business needs.'}</h2><p class="lead" style="margin-top:25px">{t.servicePageLead}</p><a class="btn" style="margin-top:30px" href={url(lang,'contact')}>{t.serviceCta} ↗</a></div><div class="detail-box"><div class="big-symbol">{sym[idx]}</div><p>{t.serviceDesc[idx]}</p></div></div></section>}
{page==='work' && <section class="container"><div class="page-hero"><h1>{t.workTitle}</h1><p class="lead">{t.workDesc}</p></div><WorkCards lang={lang}/><p class="work-disclaimer">{t.workNote}</p></section>}
{page==='about' && <section class="container"><div class="page-hero"><h1>{t.aboutTitle}</h1><p class="lead">{t.aboutLead}</p></div><div class="split section"><h2>{lang==='id'?'Tegas dalam engineering. Terbuka dalam kolaborasi.':'Engineering with purpose. Collaboration with clarity.'}</h2><p class="lead">{t.aboutBody}</p></div><div class="section"><div class="work-grid">{t.values.map((v,i)=><div class="value-card"><h3>{v}</h3><p>{t.valuesDesc[i]}</p></div>)}</div></div></section>}
{page==='insights' && <section class="container"><div class="page-hero"><h1>{t.insightsTitle}</h1><p class="lead">{t.insightsLead}</p></div><div class="empty-editorial"><span class="symbol">A/</span><h3>{lang==='id'?'Tulisan sedang disiapkan.':'Stories in the making.'}</h3><p class="muted">{t.insightsLead}</p></div></section>}
{page==='contact' && <section class="container"><div class="page-hero"><h1>{t.contactTitle}</h1><p class="lead">{t.contactLead}</p></div><div class="contact-grid"><div><h2>{lang==='id'?'Mari berdiskusi.':'Let’s talk.'}</h2><p class="lead" style="margin-top:20px">{t.ctaDesc}</p><div class="contact-options"><a href={waLink} target="_blank" rel="noopener noreferrer">WhatsApp <span>↗</span></a><a href={`mailto:${site.email}`}>{site.email}<span>↗</span></a></div><p class="muted" style="margin-top:35px">{site.address}</p></div><ContactForm lang={lang}/></div></section>}
{page==='privacy' && <section class="container"><div class="page-hero"><h1>{t.privacyTitle}</h1><p class="lead">{t.privacyLead}</p></div><div style="max-width:780px;padding-bottom:70px"><p class="lead">{t.privacyText}</p><p class="muted" style="margin-top:25px">{site.email}</p></div></section>}
{page!=='contact' && page!=='privacy' && <section class="container" style="padding-top:90px"><div class="cta-section"><h2>{t.ctaTitle}</h2><p class="lead">{t.ctaDesc}</p><a class="btn light" href={url(lang,'contact')}>{t.ctaBtn} ↗</a></div></section>}
</main><Footer lang={lang}/>
</Base>
