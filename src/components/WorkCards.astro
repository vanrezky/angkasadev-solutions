---
import { tr, type Lang } from '../data/site';
const {lang}=Astro.props as {lang:Lang}; const t=tr[lang];
const images=['portfolio-erp','portfolio-logistics','portfolio-seo'];
---
<div class="work-grid">{t.workCards.map((n,i)=><article class="work-card"><div class={`work-visual v${i+1}`}><img class="work-image" src={`/images/${images[i]}.webp`} alt={`${lang==='id'?'Visual konsep':'Concept visual'}: ${n}`} width="1600" height="1200" loading="lazy" decoding="async"/><span class="concept-label">{lang==='id'?'VISUAL KONSEP':'CONCEPT VISUAL'}</span></div><div class="work-info"><span class="tag">{t.workTags[i]}</span><h3>{n}</h3><p>{t.workCardDesc[i]}</p></div></article>)}</div>